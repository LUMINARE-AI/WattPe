# App database connection (used by Next.js at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wattpe"

# Direct connection for Prisma migrations (same as DATABASE_URL locally;
# on Neon use the unpooled endpoint here and the pooled URL in DATABASE_URL)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wattpe"

# Auth (optional for local dev)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-string"

# Email (optional — contact/reset-password forms log to console without this)
# RESEND_API_KEY=
